set default="0"
set timeout=8

insmod part_gpt
insmod fat

menuentry "Try BIT OS Cyber Edition 0.1" {
    linux (hd0,gpt1)/bzImage root=PARTUUID=%PARTUUID% rootwait rw console=ttyS0,115200 quiet loglevel=3
}

menuentry "Install BIT OS Cyber Edition 0.1" {
    linux (hd0,gpt1)/bzImage root=PARTUUID=%PARTUUID% rootwait rw bit.install=1 console=tty1 loglevel=3
}
