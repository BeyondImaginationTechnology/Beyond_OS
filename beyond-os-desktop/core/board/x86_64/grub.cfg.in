set default="0"
set timeout=8

# The USB image is a GPT disk; keep the kernel path on its EFI boot partition
# explicit because this minimal GRUB build does not include the search command.
insmod part_gpt
insmod fat

menuentry "Try Beyond Imagination OS Core Edition 1.0" {
    linux (hd0,gpt1)/bzImage root=PARTUUID=%PARTUUID% rootwait quiet loglevel=3
}

menuentry "Install Beyond Imagination OS Core Edition 1.0" {
    linux (hd0,gpt1)/bzImage root=PARTUUID=%PARTUUID% rootwait bit.install=1 console=tty1 loglevel=3
}
