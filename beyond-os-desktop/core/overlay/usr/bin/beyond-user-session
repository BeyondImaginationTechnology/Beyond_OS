#!/bin/sh
export HOME=/home/home
export DISPLAY=:0
export XAUTHORITY=/home/home/.Xauthority
export SDL_VIDEODRIVER=x11
cd "$HOME" || exit 1
# Openbox runs this after claiming the display and initializing window management.
# Starting the SDL desktop concurrently can leave its first window waiting to map.
flavour=core
[ ! -r /usr/share/beyond-imagination-os/flavour ] || flavour=$(cat /usr/share/beyond-imagination-os/flavour)
case "$flavour" in
    creator) desktop=beyond-creator ;;
    academy) desktop=beyond-academy ;;
    sentinel) desktop=beyond-sentinel ;;
    gaming) desktop=beyond-gaming ;;
    *) desktop=beyond-core ;;
esac
exec openbox --startup "/bin/sh -c '$desktop; openbox --exit'"
