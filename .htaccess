# Beyond OS 2.1 — Apache/LiteSpeed shared-hosting rules
# Files must be readable by the web server (0644); directories should be 0755.

DirectoryIndex index.php index.html

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddEncoding gzip .svgz
</IfModule>

<Files "apple-app-site-association">
  <IfModule mod_mime.c>
    ForceType application/json
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </IfModule>
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self' https: data: blob:; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data: blob:; font-src 'self' https: data:; media-src 'self' https: data: blob:; connect-src 'self' https: wss:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

  # Deployments must be visible immediately. Dynamic pages and the service
  # worker are revalidated on every request instead of being served stale.
  <FilesMatch "\.(?:php|html?)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <Files "service-worker.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Service-Worker-Allowed "/"
  </Files>

  # CSS and JavaScript may be stored locally, but the browser must check for
  # a newer deployed copy before using them.
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>

  <FilesMatch "\.(?:png|jpe?g|gif|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep implementation, migration, and database resources off the web.
  RewriteRule ^(?:config|includes|migrations|sql|docs|tools|AppStoreAssets|\.cache|beyond-chromium)(?:/|$) - [F,L,NC]
  RewriteRule ^[A-Za-z0-9_-]+(?:Apple|Android)(?:/|$) - [F,L,NC]
  RewriteRule ^server/(?:classes|cron|lib)(?:/|$) - [F,L,NC]
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

  # Serve real application files and folders directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send unknown app routes to the Beyond OS home controller.
  RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "(^\.|(?:\.env|\.ini|\.log|\.sql|\.sqlite|\.sqlite3|\.db|\.toml|\.ya?ml|\.md|\.csr|\.pem|\.key|\.p8|\.p12|\.pfx|\.mobileprovision|\.gradle|\.lock|\.xcconfig|\.pbxproj|composer\.(?:json|lock)|package(?:-lock)?\.json)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Performance: compress text responses when supported by the host.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Performance: long-lived caching for versioned/static assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/jpeg "access plus 90 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType application/pdf "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  Header append Vary Accept-Encoding
  <FilesMatch "\.(?:woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
