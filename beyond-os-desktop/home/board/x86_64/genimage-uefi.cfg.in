image efi-part.vfat {
    vfat {
        file EFI {
            image = "efi-part/EFI"
        }

        file bzImage {
            image = "bzImage"
        }
    }

    size = 32M
}

image bit-os-home-1.0-installer.img {
    hdimage {
        partition-table-type = "gpt"
    }

    partition boot {
        image = "efi-part.vfat"
        partition-type-uuid = U
        offset = 1M
        bootable = true
    }

    partition root {
        partition-type-uuid = root-x86-64
        partition-uuid = %PARTUUID%
        image = "rootfs.ext2"
    }
}
