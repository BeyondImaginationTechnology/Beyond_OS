# Keep the actual token outside the repository and grant it read access only.
HF_TOKEN=hf_replace_with_your_read_token
JAGUAR_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
# Leave blank to run the base model. Set this to the downloaded adapter directory
# after a Beyond-1 training run, for example /opt/jaguar/artifacts/jaguar-v0.1.
JAGUAR_ADAPTER_PATH=
JAGUAR_DEVICE_MAP=auto
JAGUAR_MAX_NEW_TOKENS=512
JAGUAR_MAX_INPUT_TOKENS=4096
JAGUAR_ALLOWED_ORIGINS=https://beyondimagination.co.technology
# Set the same non-empty value in the private runtime and the PHP host.
# This prevents arbitrary callers from using the runtime URL.
JAGUAR_RUNTIME_TOKEN=replace_with_a_long_random_value
