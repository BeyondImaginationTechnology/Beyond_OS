# Release artifacts are published by the release process and served directly.
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=300, must-revalidate"
</IfModule>

<IfModule mod_mime.c>
  AddType application/gzip .gz
</IfModule>

<FilesMatch "^(?:SHA256SUMS|bitCoreos\.iso\.gz|bit-os-core-(?:0\.2|1\.0)-installer\.img\.gz|coreOS\.exe)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>
