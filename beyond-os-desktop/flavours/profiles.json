{
  "creator": {
    "base": "core",
    "displayName": "Beyond Imagination OS Creator",
    "packages": ["beyond-creator", "beyond-tattoo", "beyond-music", "beyond-wallpapers", "kdenlive", "obs", "krita", "inkscape", "gimp", "vscodium", "git", "audacity", "lmms"],
    "integrations": {
      "adobeCreativeCloud": {
        "enabled": true,
        "delivery": "web",
        "url": "https://creativecloud.adobe.com/",
        "nativeDesktopInstaller": "unsupported-on-linux"
      }
    },
    "workspaces": {
      "video": {"name": "Golden Hour Studio", "jaguarHue": "#FFB45C"},
      "design": {"name": "Ink & Canvas", "jaguarHue": "#F07D70"},
      "code": {"name": "Electric Atelier", "jaguarHue": "#F26BC2"},
      "music": {"name": "Blue Note Studio", "jaguarHue": "#42D6C7"}
    },
    "defaults": ["creator-hub", "choose-your-apps", "beyond-music", "beyond-wallpapers", "creative-workspace", "large-file-workflow"]
  },
  "academy": {
    "base": "core",
    "displayName": "Beyond Imagination OS Academy",
    "packages": ["firefox", "libreoffice", "python3", "vscode", "git"],
    "defaults": ["student-account-boundary", "teacher-admin-boundary", "offline-course-content", "safe-search"]
  },
  "sentinel": {
    "base": "core",
    "displayName": "Beyond Imagination OS Sentinel",
    "packages": ["nftables", "audit", "osquery"],
    "defaults": ["deny-inbound", "signed-updates", "audit-logging", "fleet-enrollment-opt-in", "no-remote-login"]
  },
  "gaming": {
    "base": "core",
    "displayName": "Beyond Imagination OS Gaming",
    "packages": ["steam", "lutris", "gamescope", "pipewire", "vulkan", "xboxdrv"],
    "defaults": ["controller-support", "performance-mode-opt-in", "low-latency-audio", "gpu-driver-choice-at-install"]
  }
}
