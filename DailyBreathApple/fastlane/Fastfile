default_platform(:ios)

platform :ios do
  desc "Archive The Daily Breath and upload it to TestFlight"
  lane :testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
    )

    # The pipeline supplies the App Store build number independently from its
    # Azure run ID. This updates only the CI checkout without touching Git.
    increment_build_number(
      xcodeproj: "TheDailyBreath.xcodeproj",
      build_number: ENV.fetch("CI_BUILD_NUMBER")
    )

    # The project normally uses automatic signing for local development. The
    # hosted Azure agent has no Apple account, so set the three Release targets
    # to the already-installed App Store profiles in this CI checkout only.
    [
      ["TheDailyBreath", ENV.fetch("THE_DAILY_BREATH_PROFILE_NAME")],
      ["DailyBreathWidget", ENV.fetch("DAILY_BREATH_WIDGET_PROFILE_NAME")],
      ["TheDailyBreathClip", ENV.fetch("DAILY_BREATH_CLIP_PROFILE_NAME")]
    ].each do |target, profile|
      update_code_signing_settings(
        path: "TheDailyBreath.xcodeproj",
        use_automatic_signing: false,
        team_id: "FK9QM3VUNH",
        profile_name: profile,
        code_sign_identity: "Apple Distribution",
        targets: [target],
        build_configurations: ["Release"]
      )
    end

    build_app(
      project: "TheDailyBreath.xcodeproj",
      scheme: "The Daily Breath",
      clean: true,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        provisioningProfiles: {
          "technology.co.beyondimagination.thedailybreath" => ENV.fetch("THE_DAILY_BREATH_PROFILE_NAME"),
          "technology.co.beyondimagination.thedailybreath.widget" => ENV.fetch("DAILY_BREATH_WIDGET_PROFILE_NAME"),
          "technology.co.beyondimagination.thedailybreath.Clip" => ENV.fetch("DAILY_BREATH_CLIP_PROFILE_NAME")
        }
      },
      # Keep the complete Xcode diagnostics in Azure instead of reducing them
      # to a generic fastlane failure. The result bundle also makes failures
      # from signing, Swift compilation, and export reproducible.
      disable_xcpretty: true,
      result_bundle: true,
      buildlog_path: "fastlane/build_logs"
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true
    )
  end
end
