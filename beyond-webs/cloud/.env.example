# Build context: beyond-webs/. Deploy the same image twice with the two modes.
SERVICE_MODE=provisioner
PORT=8080

# Provisioner service only. Keep this value in Secret Manager.
BEYOND_WEBS_PROVISIONER_SECRET=SET_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GCP_PROJECT_ID=REPLACE_WITH_PROJECT_ID
GCP_ZONE=REPLACE_WITH_ZONE
# Map every released edition to a verified private Compute Engine image.
# The provisioner refuses unknown or unmapped flavours.
GCP_FLAVOUR_IMAGES_JSON={"Home":"projects/REPLACE_WITH_IMAGE_PROJECT/global/images/bit-os-home-0-2","Core":"projects/REPLACE_WITH_IMAGE_PROJECT/global/images/bit-os-core-0-2","Creator":"projects/REPLACE_WITH_IMAGE_PROJECT/global/images/bit-os-creator-0-1","Academy":"projects/REPLACE_WITH_IMAGE_PROJECT/global/images/bit-os-academy-0-1","Cyber":"projects/REPLACE_WITH_IMAGE_PROJECT/global/images/bit-os-cyber-0-1"}
GCP_NETWORK=global/networks/REPLACE_WITH_PRIVATE_VPC
GCP_SUBNETWORK=regions/REPLACE_WITH_REGION/subnetworks/REPLACE_WITH_SUBNET
GCP_BOOT_DISK_TYPE=pd-balanced
GCP_PROFILE_MACHINE_TYPES_JSON={"Launch":"REPLACE_WITH_VERIFIED_TYPE","Build":"REPLACE_WITH_VERIFIED_TYPE","Power":"REPLACE_WITH_VERIFIED_TYPE"}
GCP_PROFILE_ACCELERATORS_JSON={}
SESSION_MAX_RUN_SECONDS=14400

# Gateway service only. Set secrets independently of the provisioner secret.
BEYOND_WEBS_APP_ORIGIN=https://hosting.beyondimagination.co.technology
BEYOND_WEBS_LOOKUP_URL=https://hosting.beyondimagination.co.technology/api/gateway-lookup.php
BEYOND_WEBS_GATEWAY_TICKET_SECRET=SET_A_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BEYOND_WEBS_GATEWAY_COOKIE_SECRET=SET_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
