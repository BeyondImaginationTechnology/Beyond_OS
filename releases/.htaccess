# Release artifacts are published by the release process and served directly.
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=300, must-revalidate"
</IfModule>

<FilesMatch "^(?:SHA256SUMS|bitCoreos\.iso|bit-os-core-1\.0-installer\.img)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>
