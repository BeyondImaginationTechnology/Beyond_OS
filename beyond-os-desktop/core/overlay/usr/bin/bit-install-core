#!/bin/sh
# BIT OS Core installer. Installs to a selected partition or a selected whole disk.
set -eu

efi_guid=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
linux_guid=0fc63daf-8483-4772-8e79-3d69d8477de4

fail() { printf '%s\n' "Installer stopped: $*" >&2; exit 1; }
notice() { printf '%s\n' "$*"; }
partition_disk() { printf '/dev/%s\n' "$(lsblk -n -o PKNAME "$1" | head -n 1)"; }
partition_type() { lsblk -n -o TYPE "$1"; }
unmounted() {
  # A whole-disk target may contain mounted partitions, LVM/dm-crypt
  # mappings, RAID members, or swap. Check the complete lsblk descendant
  # tree so none of those devices can be overwritten underneath us.
  for device in $(lsblk -nrpo NAME "$1"); do
    findmnt -rn -S "$device" >/dev/null 2>&1 && return 1
    swapon --show=NAME --noheadings 2>/dev/null | grep -Fxq "$device" && return 1
  done
  return 0
}

[ "$(id -u)" -eq 0 ] || fail "installer must start from the installer boot entry"
[ -d /sys/firmware/efi ] || fail "UEFI boot is required"

source_root=$(findmnt -n -o SOURCE / || true)
[ -b "$source_root" ] || fail "could not identify the installer root partition"
case "$source_root" in
  /dev/sr*)
    source_kind=iso
    source_disk=
    # ISO installs copy the live filesystem into a newly formatted Core root.
    source_bytes=$((2 * 1024 * 1024 * 1024))
    ;;
  *)
    source_kind=usb
    source_disk=$(partition_disk "$source_root")
    [ -b "$source_disk" ] || fail "could not identify the installer USB"
    source_bytes=$(blockdev --getsize64 "$source_root")
    ;;
esac

notice "BIT OS Core v.02 installer"
notice "Choose where Core will be installed. The installer never chooses a disk automatically."
notice "\nAvailable block devices:"
lsblk -o NAME,SIZE,TYPE,FSTYPE,PARTTYPE,MODEL,MOUNTPOINTS
notice "\nInstallation choices:"
notice "  1) Use an existing Linux partition (keeps Windows and other partitions)"
notice "  2) Erase a whole non-USB disk for BIT OS Core"
printf 'Choose 1 or 2: '
IFS= read -r mode

target_esp_new=false
case "$mode" in
  1)
    notice "\nSelect an empty Linux partition. It must be at least as large as the Core image."
    printf 'Target Linux partition (example: /dev/nvme0n1p5): '
    IFS= read -r target_root
    [ -b "$target_root" ] || fail "target is not a block device"
    [ "$(partition_type "$target_root")" = part ] || fail "choose a partition for this installation mode"
    [ "$target_root" != "$source_root" ] || fail "the installer media cannot be the install target"
    target_disk=$(partition_disk "$target_root")
    [ "$source_kind" = iso ] || [ "$target_disk" != "$source_disk" ] || fail "the installer USB disk cannot be the install target"
    # BusyBox blkid reports filesystem metadata but not GPT PART_ENTRY_TYPE.
    # lsblk exposes the kernel's partition type and is already required here.
    root_type=$(lsblk -n -o PARTTYPE "$target_root" | head -n 1 | tr '[:upper:]' '[:lower:]')
    [ "$root_type" = "$linux_guid" ] || fail "target must use the Linux filesystem partition type; refusing to overwrite a Windows/basic-data partition"
    unmounted "$target_root" || fail "target partition is mounted"
    [ "$(blockdev --getsize64 "$target_root")" -ge "$source_bytes" ] || fail "target partition is smaller than the Core image"

    printf 'EFI System Partition on %s (example: /dev/nvme0n1p1): ' "$target_disk"
    IFS= read -r target_esp
    [ -b "$target_esp" ] || fail "EFI System Partition is not a block device"
    [ "$(partition_type "$target_esp")" = part ] || fail "EFI System Partition must be a partition"
    [ "$(partition_disk "$target_esp")" = "$target_disk" ] || fail "EFI System Partition is not on the target disk"
    esp_type=$(lsblk -n -o PARTTYPE "$target_esp" | head -n 1 | tr '[:upper:]' '[:lower:]')
    [ "$esp_type" = "$efi_guid" ] || fail "chosen partition is not an EFI System Partition"
    unmounted "$target_esp" || fail "EFI System Partition is mounted"

    notice "\nThe next step replaces only $target_root and adds a BIT OS Core UEFI entry."
    notice "It does not format $target_esp or replace Windows Boot Manager."
    printf 'Type exactly: INSTALL %s\n> ' "$target_root"
    IFS= read -r confirmation
    [ "$confirmation" = "INSTALL $target_root" ] || fail "confirmation did not match"
    ;;
  2)
    notice "\nThis option deletes every partition and file on the selected disk."
    printf 'Whole disk to erase (example: /dev/nvme0n1): '
    IFS= read -r target_disk
    [ -b "$target_disk" ] || fail "target is not a block device"
    [ "$(partition_type "$target_disk")" = disk ] || fail "choose a whole disk for this installation mode"
    [ "$source_kind" = iso ] || [ "$target_disk" != "$source_disk" ] || fail "the installer USB disk cannot be erased"
    # The layout consumes a 512 MiB EFI partition in addition to the image,
    # plus a small alignment margin. Validate the complete footprint before
    # any wipe operation; the old check could erase a disk and only then
    # discover that the root partition could not hold the image.
    layout_overhead=$((512 * 1024 * 1024 + 4 * 1024 * 1024))
    required_bytes=$((source_bytes + layout_overhead))
    [ "$(blockdev --getsize64 "$target_disk")" -ge "$required_bytes" ] || fail "disk is too small for the Core image and EFI layout"
    unmounted "$target_disk" || fail "refusing to erase a disk with mounted or active descendant devices"
    printf 'Type exactly: ERASE %s\n> ' "$target_disk"
    IFS= read -r confirmation
    [ "$confirmation" = "ERASE $target_disk" ] || fail "confirmation did not match"

    notice "Creating the BIT OS Core partition layout..."
    wipefs -a "$target_disk"
    printf 'label: gpt\n,512M,U\n,,L\n' | sfdisk --wipe always --wipe-partitions always "$target_disk"
    blockdev --rereadpt "$target_disk" || true
    udevadm settle || true
    sleep 2
    target_esp=$(lsblk -nrpo NAME,PARTTYPE "$target_disk" | awk -v type="$efi_guid" 'tolower($2) == type { print $1; exit }')
    target_root=$(lsblk -nrpo NAME,PARTTYPE "$target_disk" | awk -v type="$linux_guid" 'tolower($2) == type { print $1; exit }')
    [ -b "$target_esp" ] && [ -b "$target_root" ] || fail "could not create the Core partition layout"
    [ "$(blockdev --getsize64 "$target_root")" -ge "$source_bytes" ] || fail "new Core partition is smaller than the Core image"
    target_esp_new=true
    ;;
  *) fail "choose 1 or 2" ;;
esac

notice "Making the installer root read-only and copying the Core filesystem..."
mount -o remount,ro / || fail "could not protect the source filesystem"
if [ "$source_kind" = usb ]; then
  # BusyBox dd in the installer does not implement GNU dd's status=progress.
  dd if="$source_root" of="$target_root" bs=16M conv=fsync
  e2fsck -pf "$target_root" || [ "$?" -eq 1 ] || fail "filesystem check failed"
  resize2fs "$target_root"
else
  mkfs.ext4 -F -L BEYOND_CORE "$target_root"
  install -d /tmp/bit-target-root
  mount "$target_root" /tmp/bit-target-root
  tar -C / --one-file-system --exclude=./dev --exclude=./proc --exclude=./sys \
    --exclude=./run --exclude=./tmp --exclude=./mnt --exclude=./media --exclude=./var -cpf - . |
    tar -C /tmp/bit-target-root -xpf -
  install -d -m 0755 /tmp/bit-target-root/var/cache /tmp/bit-target-root/var/lib /tmp/bit-target-root/var/log
  install -d -m 1777 /tmp/bit-target-root/var/tmp
  sync
  umount /tmp/bit-target-root
fi

target_uuid=$(blkid -s PARTUUID -o value "$target_root" || true)
[ -n "$target_uuid" ] || fail "could not read target partition UUID"
install -d /tmp/bit-target-esp
if [ "$target_esp_new" = true ]; then
  mkfs.vfat -F 32 -n BITOS_EFI "$target_esp"
fi
mount "$target_esp" /tmp/bit-target-esp
install -d /tmp/bit-target-esp/EFI/BITOS
if [ "$source_kind" = usb ]; then
  source_esp=$(lsblk -nrpo NAME,PARTTYPE "$source_disk" | awk -v type="$efi_guid" 'tolower($2) == type { print $1; exit }')
  [ -n "$source_esp" ] && [ -b "$source_esp" ] || fail "could not locate the installer EFI partition"
  install -d /tmp/bit-source-esp
  mount -o ro "$source_esp" /tmp/bit-source-esp
  cp /tmp/bit-source-esp/EFI/BOOT/bootx64.efi /tmp/bit-target-esp/EFI/BITOS/bootx64.efi
  umount /tmp/bit-source-esp
else
  mcopy -o -i /boot/fat.efi ::EFI/BOOT/bootx64.efi /tmp/bit-target-esp/EFI/BITOS/bootx64.efi
fi
sed "s/%PARTUUID%/$target_uuid/g" /usr/share/beyond-core/grub.cfg.in > /tmp/bit-target-esp/EFI/BITOS/grub.cfg
sync
umount /tmp/bit-target-esp

esp_number=$(lsblk -n -o PARTN "$target_esp")
# Buildroot does not mount efivarfs automatically. efibootmgr needs it in
# order to persist the BIT OS entry in UEFI NVRAM.
efi_vars=/sys/firmware/efi/efivars
if ! grep -qs " $efi_vars efivarfs " /proc/mounts; then
  mount -t efivarfs efivarfs "$efi_vars" || fail "could not mount UEFI variable storage"
fi
efibootmgr -c -d "$target_disk" -p "$esp_number" -L "BIT OS Core" -l '\\EFI\\BITOS\\bootx64.efi'
notice "Installation completed. Remove the USB and choose BIT OS Core from UEFI boot options."
exec /sbin/reboot -f
